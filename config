[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "master"]
	remote = origin
	merge = refs/heads/master
	vscode-merge-base = origin/master
[remote "github"]
	url = https://github.com/qiuhai182/encoding-switcher.git
	fetch = +refs/heads/*:refs/remotes/github/*
[remote "gitee"]
	url = https://gitee.com/qiuhai182/encoding-switcher.git
	fetch = +refs/heads/*:refs/remotes/gitee/*
